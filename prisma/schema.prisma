generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdStatus {
  READY
  WARNING
  BLOCKED
  REVIEW
}

enum UserRole {
  SUPER_ADMIN
  PARTY_ADMIN
  CENTRAL_REVIEWER
  LOCAL_ADMIN
  CAMPAIGN_MANAGER
  CANDIDATE
  DESIGNER
  READONLY_AUDITOR
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameCs    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns         Campaign[]
  organizationUnits OrganizationUnit[]
  ads               Ad[]
  auditLogs         AuditLog[]
  memberships       TenantMembership[]
  invitations       Invitation[]

  @@map("tenants")
}

model Campaign {
  id        String   @id @default(cuid())
  tenantId  String
  slug      String
  nameCs    String
  nameEn    String
  election  String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ads    Ad[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("campaigns")
}

model OrganizationUnit {
  id        String   @id @default(cuid())
  tenantId  String
  slug      String
  kind      String
  nameCs    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ads    Ad[]
  memberships TenantMembership[]
  invitations Invitation[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("organization_units")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships TenantMembership[]
  invitations Invitation[] @relation("InvitationInviter")

  @@map("users")
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  orgUnitId String?
  role      UserRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit OrganizationUnit? @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([orgUnitId])
  @@map("tenant_memberships")
}

model Invitation {
  id              String           @id @default(cuid())
  tenantId        String
  orgUnitId       String?
  email           String
  role            UserRole
  status          InvitationStatus @default(PENDING)
  token           String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orgUnit   OrganizationUnit? @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  invitedBy User?             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([orgUnitId])
  @@map("invitations")
}

model Ad {
  id              String   @id @default(cuid())
  tenantId        String
  campaignId      String
  orgUnitId       String
  code            String
  publicToken     String   @unique
  titleCs         String
  titleEn         String
  ownerCs         String
  ownerEn         String
  mediaTypeCs     String
  mediaTypeEn     String
  channel         String   @default("offline")
  publicationDate DateTime
  periodCs        String
  periodEn        String
  distributionAreaCs String @default("")
  distributionAreaEn String @default("")
  payerCs         String
  payerEn         String
  supplierCs      String   @default("")
  supplierEn      String   @default("")
  amount          String   @default("")
  fundingSourceCs String   @default("")
  fundingSourceEn String   @default("")
  language        String   @default("cs")
  isTargeted      Boolean  @default(false)
  targetingCs     String   @default("")
  targetingEn     String   @default("")
  targetAudienceCs String  @default("")
  targetAudienceEn String  @default("")
  missingCs       String[]
  missingEn       String[]
  status          AdStatus
  statusLabelCs   String
  statusLabelEn   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  orgUnit   OrganizationUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, campaignId])
  @@index([tenantId, orgUnitId])
  @@map("ads")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  adId      String?
  actor     String
  action    String
  messageCs String
  messageEn String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad     Ad?    @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([adId, createdAt])
  @@map("audit_logs")
}
