{
  "name": "adclare-eu",
  "version": "0.2.0-beta.5",
  "type": "module",
  "private": false,
  "license": "EUPL-1.2",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "test": "npm run test:launch && npm run test:audit && npm run test:audit-query && npm run test:workflow",
    "test:launch": "node scripts/launch-smoke.mjs",
    "test:audit": "tsx scripts/audit-chain-smoke.ts",
    "test:audit-query": "tsx scripts/audit-query-smoke.ts",
    "test:workflow": "tsx scripts/workflow-smoke.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "launch:preflight": "node scripts/production-preflight.mjs",
    "launch:smoke": "node scripts/production-smoke.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ci": "npm run test && npm run test:e2e && npm run security:scan && npx prisma validate && npm run db:generate && npm run lint && npm run typecheck && npm audit --omit=dev && npm run build",
    "docker:check": "docker build --target migrator -t adclare-migrate-check . && docker build --target storage-check -t adclare-storage-check . && docker build --target preflight -t adclare-preflight-check . && docker build -t adclare-web-check .",
    "security:scan": "node scripts/security-scan.mjs",
    "storage:check": "node scripts/check-object-storage.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "cf:setup": "node scripts/cloudflare-setup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "pg": "8.18.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "fast-uri": "^4.1.1",
    "find-my-way": "^9.7.0",
    "valibot": "^1.4.2",
    "brace-expansion@<2": "1.1.16",
    "brace-expansion@>=3": "5.0.8",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.11",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "typescript-eslint": "^8.65.0"
  }
}
