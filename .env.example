NEXT_PUBLIC_APP_URL=https://adclare.eu
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADWL1GxcsZgXYZe1
TURNSTILE_SECRET_KEY=replace_with_cloudflare_turnstile_secret

# Local development through docker-compose.yml.
DATABASE_URL=postgresql://adclare:adclare_dev_password@localhost:5433/adclare_dev?schema=public

# Production docker-compose.prod.yml.
# Use a generated alphanumeric password and set DATABASE_URL to host `db`.
POSTGRES_DB=adclare_prod
POSTGRES_USER=adclare
POSTGRES_PASSWORD=replace_with_generated_password
# DATABASE_URL=postgresql://adclare:replace_with_generated_password@db:5432/adclare_prod?schema=public

# Optional Cloudflare setup automation.
CLOUDFLARE_API_TOKEN=
CF_ZONE_NAME=adclare.eu
ORIGIN_IPV4=46.224.66.79
CF_SSL_MODE=full
SETUP_EMAIL_ROUTING=0
EMAIL_DESTINATION=
EMAIL_ALIASES=hello,billing,support,security
CREATE_TURNSTILE=0
TURNSTILE_WIDGET_NAME=Adclare production
