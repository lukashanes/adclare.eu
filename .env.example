NEXT_PUBLIC_APP_URL=https://adclare.eu
TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_cloudflare_turnstile_secret
TURNSTILE_REQUIRED=1
TURNSTILE_ALLOWED_HOSTNAMES=adclare.eu,www.adclare.eu
NEXT_PUBLIC_SHOW_DEMO_REPO=0

# Transactional email through Cloudflare Email Service REST API.
# Invites are written to the DB outbox even when these are empty.
EMAIL_FROM=Adclare <noreply@adclare.eu>
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
BILLING_NOTIFICATION_EMAIL=lh@aenze.com

# Stripe Billing. Without these keys the admin can store billing state, but cannot create real checkout sessions yet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Temporary protected admin access until full user accounts are implemented.
ADMIN_ACCESS_PASSWORD=replace_with_admin_password
ADMIN_SESSION_SECRET=replace_with_admin_session_secret_min_32_chars

# Local development through docker-compose.yml.
DATABASE_URL=postgresql://adclare:adclare_dev_password@localhost:5433/adclare_dev?schema=public

# Production docker-compose.prod.yml.
# Use a generated alphanumeric password and set DATABASE_URL to host `db`.
POSTGRES_DB=adclare_prod
POSTGRES_USER=adclare
POSTGRES_PASSWORD=replace_with_generated_password
# DATABASE_URL=postgresql://adclare:replace_with_generated_password@db:5432/adclare_prod?schema=public

# Optional Cloudflare setup automation.
CLOUDFLARE_API_TOKEN=
CF_ZONE_NAME=adclare.eu
ORIGIN_IPV4=46.224.66.79
CF_SSL_MODE=full_strict
SETUP_EMAIL_ROUTING=0
EMAIL_DESTINATION=
EMAIL_ALIASES=hello,billing,support,security
CREATE_TURNSTILE=0
TURNSTILE_WIDGET_NAME=Adclare production
