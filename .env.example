APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_cloudflare_turnstile_secret
TURNSTILE_REQUIRED=0
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
NEXT_PUBLIC_SHOW_DEMO_REPO=0

# File storage for uploaded ad assets.
# local: store files on disk; Docker Compose mounts /data/uploads as a persistent volume.
# s3: use Hetzner Object Storage or any S3-compatible bucket.
ADCLARE_STORAGE_DRIVER=local
ADCLARE_LOCAL_STORAGE_DIR=.data/uploads
OBJECT_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
OBJECT_STORAGE_REGION=fsn1
OBJECT_STORAGE_BUCKET=adclare-assets
OBJECT_STORAGE_ACCESS_KEY_ID=replace_with_object_storage_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_with_object_storage_secret
OBJECT_STORAGE_FORCE_PATH_STYLE=0
OBJECT_STORAGE_PUBLIC_BASE_URL=
MAX_AD_ASSET_UPLOAD_MB=50

# Transactional email through Cloudflare Email Service REST API.
# Local development can keep these empty. Public production should use
# production.env.example and pass npm run launch:preflight before real users.
EMAIL_FROM=Adclare <noreply@localhost>
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
ADCLARE_LOG_EMAIL_LINKS=1
SUPPORT_EMAIL=support@adclare.eu

# first-run: only the first workspace can be created from /signup.
# open: allow public creation of additional workspaces.
# disabled: require invitations only.
SIGNUP_MODE=first-run

# Local development and root docker-compose.yml.
DATABASE_URL=postgresql://adclare:adclare_dev_password@localhost:5433/adclare_dev?schema=public
DOCKER_DATABASE_URL=postgresql://adclare:adclare_dev_password@db:5432/adclare_dev?schema=public

# Local root docker-compose.yml values.
POSTGRES_DB=adclare_dev
POSTGRES_USER=adclare
POSTGRES_PASSWORD=adclare_dev_password

# Public production values belong in production.env.example.

# Optional Cloudflare setup automation.
CLOUDFLARE_API_TOKEN=
CF_ZONE_NAME=adclare.example.org
ORIGIN_IPV4=203.0.113.10
CF_SSL_MODE=strict
SETUP_EMAIL_ROUTING=0
EMAIL_DESTINATION=
EMAIL_ALIASES=hello,support,security
CREATE_TURNSTILE=0
TURNSTILE_WIDGET_NAME=Adclare self-hosted
